# Local Edge Function secrets (supabase functions serve --env-file supabase/functions/.env).
# In production set these with `supabase secrets set`.
ANTHROPIC_API_KEY=          # hosted formatting fallback (claude-haiku-5-5)
OPENAI_API_KEY=             # hosted transcription fallback (gpt-4o-transcribe)
CRON_SECRET=                # shared with private.secrets 'cron_secret' for pg_cron calls
# Locally only: signed URLs otherwise point at the edge runtime's internal host
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# APNs for weekly reminders (optional locally)
APNS_KEY_ID=
APNS_TEAM_ID=KT2Y8F24DZ
APNS_TOPIC=com.blai.weeknotes
APNS_PRIVATE_KEY=
